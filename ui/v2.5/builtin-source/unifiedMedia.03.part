    // scene/video or image opens the shared preview directly (unless selection
    // mode is active). Grid mode keeps the normal magnifying-glass affordance.

    const anchorProps = {
      className: "unified-media-wall-anchor",
      onClick: onContainerClick,
      style: { width: "100%", height: "100%" },
    };
    const anchor = Link
      ? React.createElement(Link, { ...anchorProps, to: href }, media)
      : React.createElement("a", { ...anchorProps, href }, media);

    return React.createElement(
      "div",
      {
        className: "unified-media-wall-item",
        style: { width: `${Math.max(1, width)}px`, height: `${Math.max(1, height)}px` },
      },
      React.createElement("input", {
        type: "checkbox",
        className: "wall-item-check mousetrap unified-media-wall-check",
        checked: selected,
        onChange: (ev) => onSelect(ev.target.checked, false),
        onClick: (ev) => ev.stopPropagation(),
        "aria-label": `Select ${entry.title}`,
      }),
      entry.type === "image" && imageAnimationLabel(item)
        ? React.createElement(GifBadge, { key: "gif", label: imageAnimationLabel(item) })
        : null,
      anchor
    );
  }

  function MixedWall({ pageItems, ctx, selectableKeys, openPreviewByKey, zoomIndex }) {
    const [containerRef, containerWidth] = useElementWidth();
    const rows = React.useMemo(
      () => buildJustifiedWallRows(pageItems, containerWidth, zoomIndex),
      [pageItems, containerWidth, zoomIndex]
    );

    return React.createElement(
      "div",
      { className: "unified-media-wall", ref: containerRef },
      rows.map((row, rowIndex) =>
        React.createElement(
          "div",
          {
            key: `row-${rowIndex}`,
            className: "unified-media-wall-row",
            style: { gap: `${row.gap}px`, height: `${row.height}px` },
          },
          row.items.map(({ entry, width, height }) =>
            React.createElement(MixedWallItem, {
              key: entry.key,
              entry,
              width,
              height,
              ctx,
              selectableKeys,
              openPreviewByKey,
            })
          )
        )
      )
    );
  }

  function NativeScenePlayer({ scene: initialScene, onNext, onPrevious }) {
    const loadables = React.useMemo(
      () => [api.loadableComponents?.ScenePlayer, api.loadableComponents?.Scenes].filter(Boolean),
      []
    );
    const loadingComponents = api.hooks?.useLoadComponents
      ? api.hooks.useLoadComponents(loadables) : false;
    const useFindScene = api.utils?.StashService?.useFindScene;
    const queryResult = useFindScene
      ? useFindScene(String(initialScene.id))
      : { data: { findScene: initialScene }, loading: false };
    const queriedScene = queryResult?.data?.findScene;
    const scene = queriedScene && String(queriedScene.id) === String(initialScene.id)
      ? queriedScene : initialScene;
    const ScenePlayer = nativeComponent("ScenePlayer");
    const noop = React.useCallback(() => {}, []);
    let content;
    if (loadingComponents || queryResult?.loading) {
      const Loading = nativeComponent("LoadingIndicator");
      content = Loading ? React.createElement(Loading)
        : React.createElement("div", { className: "text-muted" }, "Loading video…");
    } else if (!ScenePlayer || !scene?.sceneStreams || !Array.isArray(scene.files)) {
      content = React.createElement("div", {
        className: "alert alert-warning unified-media-native-player-error",
      }, "Stash's native ScenePlayer could not be loaded for this preview.");
    } else {
      content = React.createElement(ScenePlayer, {
        scene,
        playerId: `StashBooruPreview-${initialScene.id}`,
        hideScrubberOverride: true,
        autoplay: true,
        permitLoop: false,
        initialTimestamp: 0,
        sendSetTimestamp: noop,
        onComplete: noop,
        onNext,
        onPrevious,
      });
    }
    return React.createElement("div", {
      className: "unified-media-native-scene-player",
      "data-scene-id": String(initialScene.id),
    }, content);
  }

  // A preview owns the sequence captured at open. Queries can still hydrate
  // the native player, but background card updates must not replace the Video
  // at the viewer's numeric index. The viewer and player read the same queue.
  function usePreviewSequence(availableEntries) {
    const [previewEntries, setPreviewEntries] = React.useState(null);
    const entries = React.useMemo(() => {
      if (!previewEntries) return availableEntries;
      // Preserve captured membership/order while allowing edits and hydration
      // of the same media identity to appear in the native viewer.
      const latestByKey = new Map(availableEntries.map((entry) => [entry.key, entry]));
      return previewEntries.map((entry) => latestByKey.get(entry.key) || entry);
    }, [availableEntries, previewEntries]);
    const beginPreview = React.useCallback(() => {
      const entries = availableEntries.slice();
      setPreviewEntries(entries);
      return {
        images: entries.map(entryToLightboxImage),
        pageSize: entries.length || 1,
        totalCount: entries.length,
      };
    }, [availableEntries]);
    const resetPreview = React.useCallback(() => {
      setPreviewEntries(null);
    }, []);
    return { entries, beginPreview, resetPreview };
  }

  // Native scene cards share the viewer's declarative media renderer.
  function PageScenePreviewHost({ scenes, registerOpen, onClosed }) {
    const availableEntries = React.useMemo(
      () => (scenes || []).map((scene) => wrap("scene", scene)), [scenes]
    );
    const { entries, beginPreview, resetPreview } = usePreviewSequence(availableEntries);
    const lightboxItems = React.useMemo(
      () => entries.map(entryToLightboxImage), [entries]
    );
    const indexByID = React.useMemo(
      () => new Map(availableEntries.map((entry, index) => [String(entry.id), index])),
      [availableEntries]
    );
    const handleClose = React.useCallback(() => {
      resetPreview();
      onClosed?.();
    }, [resetPreview, onClosed]);
    const showLightbox = api.hooks?.useLightbox
      ? api.hooks.useLightbox({
          images: lightboxItems,
          showNavigation: false,
          page: 1,
          pages: 1,
          pageSize: lightboxItems.length || 1,
          totalCount: lightboxItems.length,
          slideshowEnabled: false,
          onClose: handleClose,
        }) : null;
    const openScene = React.useCallback((scene) => {
      if (!showLightbox || !scene || document.querySelector(".Lightbox")) return;
      const index = indexByID.get(String(scene.id));
      if (index == null) return;
      showLightbox({ ...beginPreview(), initialIndex: index, slideshowEnabled: false, slideshowAutostart: false });
    }, [showLightbox, indexByID, beginPreview]);
    React.useEffect(() => registerOpen?.(openScene), [registerOpen, openScene]);
    return null;
  }
