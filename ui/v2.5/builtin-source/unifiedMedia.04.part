        // LightboxImage. That makes ScenePlayer obey Original/Fit X/Fit Y/Fit
        // Screen and the native zoom/pan transform without reimplementing it.
        const nativeMedia = target.querySelector(
          ".Lightbox-carousel-image-wrapper img, .Lightbox-carousel-image-wrapper video"
        );
        if (nativeMedia) {
          const mediaRect = nativeMedia.getBoundingClientRect();
          const nextGeometry = {
            left: mediaRect.left,
            top: mediaRect.top,
            width: mediaRect.width,
            height: mediaRect.height,
          };
          setScenePortalGeometry((old) => {
