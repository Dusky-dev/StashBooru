      [pageVisualEntries]
    );

    // The Lightbox remains Stash's native image/lightbox shell and owns mixed
    // next/previous navigation. For scene entries, replace only the current
    // carousel slide's media area with Stash's real ScenePlayer via a React
    // portal. This avoids the HTML <video> sizing/transform mismatch entirely.
    const [activeVisualIndex, setActiveVisualIndex] = React.useState(null);
    const [scenePortalTarget, setScenePortalTarget] = React.useState(null);
    const [scenePortalGeometry, setScenePortalGeometry] = React.useState(null);
    const lightboxObserverRef = React.useRef(null);
    const lightboxSyncFrameRef = React.useRef(null);

    const cleanupNativeLightbox = React.useCallback(() => {
      document.body.classList.remove("unified-media-native-lightbox-open");
      document.querySelectorAll(".Lightbox-carousel-image.unified-media-native-scene-slide").forEach((node) =>
        node.classList.remove("unified-media-native-scene-slide")
      );
      document.querySelectorAll(".Lightbox-footer-center .image-link").forEach((link) => {
        const handler = link.__unifiedMediaSceneNavigateHandler;
        if (handler) link.removeEventListener("click", handler, true);
        delete link.__unifiedMediaSceneNavigateHandler;
