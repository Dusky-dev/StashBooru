        setActiveVisualIndex((old) => old === index ? old : index);
        setScenePortalTarget(null);
        setScenePortalGeometry(null);
      }

      const footerLink = lightbox.querySelector(".Lightbox-footer-center .image-link");
      if (footerLink) {
        const oldHandler = footerLink.__unifiedMediaSceneNavigateHandler;
        if (oldHandler) {
          footerLink.removeEventListener("click", oldHandler, true);
          delete footerLink.__unifiedMediaSceneNavigateHandler;
        }

        if (entry?.type === "scene") {
          const scene = entry.item;
          const scenePath = `/scenes/${scene.id}`;
          const filename = sceneFilename(scene);
          footerLink.setAttribute("href", scenePath);
          footerLink.textContent = filename;
          footerLink.removeAttribute("aria-disabled");
          footerLink.removeAttribute("tabindex");
          footerLink.style.pointerEvents = "";
