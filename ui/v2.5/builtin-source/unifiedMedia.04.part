

        if (entry) {
          const scene = entry.item;
          const scenePath = `/scenes/${scene.id}`;
          footerLink.setAttribute("href", scenePath);
          footerLink.textContent = sceneFilename(scene);
          footerLink.removeAttribute("aria-disabled");
          footerLink.removeAttribute("tabindex");
          footerLink.style.pointerEvents = "";
          footerLink.classList.add("unified-media-scene-lightbox-title");

          const handler = (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            ev.stopImmediatePropagation?.();
            if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button === 1) {
              window.open(scenePath, "_blank", "noopener");
              return;
            }
            window.location.replace(scenePath);
          };
          footerLink.__unifiedMediaSceneNavigateHandler = handler;
          footerLink.addEventListener("click", handler, true);
