      schedule();
      setTimeout(schedule, 50);
      setTimeout(schedule, 250);
      setTimeout(schedule, 450);
    }, [cleanup, sync]);

    React.useEffect(() => cleanup, [cleanup]);

    const lightboxPrevious = React.useCallback(() => {
      const buttons = document.querySelectorAll(".Lightbox-display > .Lightbox-navbutton");
      buttons?.[0]?.click?.();
    }, []);
    const lightboxNext = React.useCallback(() => {
      const buttons = document.querySelectorAll(".Lightbox-display > .Lightbox-navbutton");
      buttons?.[buttons.length - 1]?.click?.();
    }, []);

    const handleClose = React.useCallback(() => {
      cleanup();
      onClosed?.();
    }, [cleanup, onClosed]);

