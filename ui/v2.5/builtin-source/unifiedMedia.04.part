    return activeEntry && portalTarget
      ? React.createElement(NativeScenePlayerPortal, {
          key: `unified-media-page-scene-player:${activeEntry.id}`,
          entry: activeEntry,
          target: portalTarget,
          geometry: portalGeometry,
          onNext: lightboxNext,
          onPrevious: lightboxPrevious,
