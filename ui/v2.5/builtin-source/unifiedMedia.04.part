      lightboxObserverRef.current = observer;
      observer.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["style", "href", "class"],
      });
      scheduleSync();
      setTimeout(scheduleSync, 50);
      setTimeout(scheduleSync, 250);
    }, [cleanupNativeLightbox, syncNativeLightbox]);

    React.us