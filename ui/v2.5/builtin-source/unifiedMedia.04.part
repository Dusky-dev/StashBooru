  function PageMediaEnhancementProvider({ children }) {
    const registryRef = React.useRef(new Map());
    const countsRef = React.useRef(new Map());
    const [registryVersion, setRegistryVersion] = React.useState(0);
    const openerRef = React.useRef(null);
    const [wallSceneID, setWallSceneID] = React.useState(null);
    const [pendingOpenID, setPendingOpenID] = React.useState(null);
    const [transientScene, setTransientScene] = React.useState(null);

    const wallSceneQuery = api.GQL?.useFindSceneQuery
      ? api.GQL.useFindSceneQuery({
          variables: { id: wallSceneID || "" },
          skip: !wallSceneID,
          fetchPolicy: "cache-first",
        })
      : null;

    const registerScene = React.useCallback((scene) => {
      if (!scene?.id) return undefined;
      const id = String(scene.id);
      registryRef.current.set(id, scene);
      countsRef.current.set(id, (countsRef.current.get(id) || 0) + 1);
      setRegistryVersion((v) => v + 1);
      return () => {
        const nextCount = Math.max(0, (countsRef.current.get(id) || 1) - 1);
        if (nextCount === 0) {
          countsRef.current.delete(id);
          registryRef.current.delete(id);
        } else {
          countsRef.current.set(id, nextCount);
        }
        setRegistryVersion((v) => v + 1);
      };
    }, []);

    const registerOpen = React.useCallback((opener) => {
      openerRef.current = opener;
      return () => {
        if (openerRef.current === opener) openerRef.current = null;
      };
    }, []);

    const openScenePreview = React.useCallback((scene) => {
      openerRef.current?.(scene);
    }, []);

    React.useEffect(() => {
      const scene = wallSceneQuery?.data?.findScene;
      if (!scene || !wallSceneID || String(scene.id) !== String(wallSceneID)) return;
      setTransientScene(scene);
      setPendingOpenID(String(scene.id));
      setWallSceneID(null);
    }, [wallSceneQuery?.data, wallSceneID]);

    const scenes = React.useMemo(() => {
      const values = Array.from(registryRef.current.values());
      if (transientScene && !values.some((scene) => String(scene.id) === String(transientScene.id))) {
        values.push(transientScene);
      }
      return values;
    }, [registryVersion, transientScene]);

    React.useEffect(() => {
      if (!pendingOpenID) return;
      const scene = scenes.find((value) => String(value.id) === String(pendingOpenID));
      if (!scene || !openerRef.current) return;
      openerRef.current(scene);
      setPendingOpenID(null);
    }, [scenes, pendingOpenID]);

    // Native image walls don't use ImageCard.Image, so add the GIF marker to
    // their rendered wall items as a DOM enhancement. Also keep Stash's delayed
    // 2x wall hover zoom disabled on these detail-page tabs, matching All.
    React.useEffect(() => {
      let frame = 0;
      const scan = () => {
        frame = 0;
        document.querySelectorAll(
          ".performer-tabs .wall-item, .studio-tabs .wall-item, .tag-tabs .wall-item"
        ).forEach((item) => {
          if (item.querySelector(":scope > .media-animation-badge")) return;
          const media = item.querySelector("img, video");
          const src = media?.currentSrc || media?.getAttribute?.("src") || "";
          const label = item.getAttribute("data-animation-badge") || (/\.gif(?:$|[?#])/i.test(String(src)) ? "GIF" : "");
          let badge = item.querySelector(":scope > .unified-media-native-wall-gif-badge");
          if (label && !badge) {
            badge = document.createElement("span");
            badge.className = "unified-media-gif-badge unified-media-native-wall-gif-badge";
            badge.textContent = label;
            badge.setAttribute("aria-label", label);
            badge.setAttribute("title", label);
            item.appendChild(badge);
          } else if (!label && badge) {
            badge.remove();
          } else if (badge && badge.textContent !== label) {
            badge.textContent = label;
            badge.setAttribute("aria-label", label);
            badge.setAttribute("title", label);
          }
        });
      };
      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(scan);
      };
      const observer = new MutationObserver(schedule);
      observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["src", "data-animation-badge"] });
      schedule();
      return () => {
        observer.disconnect();
        if (frame) cancelAnimationFrame(frame);
      };
    }, []);

    // SceneWallPanel is not a patchable component in this Stash generation.
    // Capture clicks on its media area so Wall view on the normal Videos tab
    // opens the same native preview instead of navigating straight to the scene.
    // Footer/title links remain normal navigation, and selection mode is left
    // entirely to Stash.
    React.useEffect(() => {
      const onClick = (ev) => {
        const item = ev.target?.closest?.(".scene-wall .wall-item");
        if (!item) return;
        const shell = item.closest(".performer-tabs, .studio-tabs, .tag-tabs");
        if (!shell) return;
        if (ev.target?.closest?.(".wall-item-check, .wall-item-footer a")) return;
        if (item.closest(".unified-media-wall")) return;
        if (item.parentElement?.querySelector?.('.wall-item-check:checked')) return;

        const link = item.querySelector('.wall-item-footer a[href*="/scenes/"]');
        const href = link?.getAttribute?.("href") || "";
        const match = href.match(/\/scenes\/([^/?#]+)/);
        if (!match) return;
        const id = decodeURIComponent(match[1]);

        ev.preventDefault();
        ev.stopPropagation();
        ev.stopImmediatePropagation?.();

        const registered = registryRef.current.get(String(id));
        if (registered) {
          openerRef.current?.(registered);
        } else if (api.GQL?.useFindSceneQuery) {
          setWallSceneID(String(id));
        }
      };
      document.addEventListener("click", onClick, true);
      return () => document.removeEventListener("click", onClick, true);
    }, []);

    const value = React.useMemo(
      () => ({ registerScene, openScenePreview }),
      [registerScene, openScenePreview]
    );

    return React.createElement(
      PageMediaContext.Provider,
      { value },
      children,
      React.createElement(PageScenePreviewHost, { scenes, registerOpen })
    );
  }

  function MixedGrid({ ctx, filter }) {
    const loadingBundles = useNativeBundles();
    const q = useMixedQueries(ctx, filter);
    const status = queryStatus(q, ctx.kind);
    const allItems = React.useMemo(
      () => collectItems(ctx, q),
      [
        ctx.kind,
        ctx.entity.id,
        q.scenes.data,
        q.images.data,
        q.galleries.data,
        q.groups.data,
        q.performers.data,
        q.studios.data,
        q.markers.data,
      ]
    );
    const sorted = React.useMemo(
      () => [...allItems].sort((a, b) => compareMixed(a, b, filter)),
      [allItems, filter?.sortBy, filter?.sortDirection, filter?.randomSeed]
    );
    const wallMode = Number(filter?.displayMode) === DisplayMode.Wall;
    const displayItems = React.useMemo(
      () => wallMode ? sorted.filter((x) => x.type === "scene" || x.type === "image") : sorted,
      [sorted, wallMode]
    );
    const selectableKeys = React.useMemo(() => displayItems.map((x) => x.key), [displayItems]);
    React.useEffect(() => {
      ctx.setSelectionUniverse(selectableKeys);
    }, [ctx, selectableKeys]);

    const [page, setPage] = React.useState(1);
    const perPage = Math.max(1, Number(filter?.itemsPerPage) || 40);
    const criteriaSignature = React.useMemo(() => {
      try { return JSON.stringify(filter?.makeFilter?.() || {}); } catch (_) { return ""; }
    }, [filter]);

    React.useEffect(() => setPage(1), [
      ctx.kind,
      ctx.entity.id,
      ctx.includeChildren,
      filter?.searchTerm,
      filter?.sortBy,
      filter?.sortDirection,
      filter?.randomSeed,
      filter?.displayMode,
      perPage,
      criteriaSignature,
    ]);
    React.useEffect(() => {
      ctx.clearSelection();
    }, [ctx.kind, ctx.entity.id, ctx.includeChildren, filter?.searchTerm, filter?.displayMode, criteriaSignature]);

    const pages = Math.max(1, Math.ceil(displayItems.length / perPage));
    React.useEffect(() => {
      if (page > pages) setPage(pages);
    }, [page, pages]);

    const pageItems = React.useMemo(
      () => displayItems.slice((page - 1) * perPage, page * perPage),
      [displayItems, page, perPage]
    );

    // One native Stash lightbox sequence for all visual media on this mixed
    // page. Images remain their real Image objects; scenes are safe synthetic
    // ILightboxImage-compatible entries backed by Stash's generated preview.
    const availableVisualEntries = React.useMemo(
      () => pageItems.filter((x) => x.type === "scene" || x.type === "image"),
      [pageItems]
    );
    const { entries: pageVisualEntries, beginPreview, resetPreview } = usePreviewSequence(availableVisualEntries);
    const lightboxItems = React.useMemo(
      () => pageVisualEntries.map(entryToLightboxImage),
      [pageVisualEntries]
    );
    const visualIndexByKey = React.useMemo(
      () => new Map(availableVisualEntries.map((entry, index) => [entry.key, index])),
      [availableVisualEntries]
    );
